// Global compatibility shims (Root "." namespace)

cc_library_shared {
    name: "libtinyxml2-v34",
    shared_libs: ["libtinyxml2"],
    vendor: true,
}

cc_library_shared {
    name: "libssl_shim",
    shared_libs: ["libssl"],
    vendor: true,
}

cc_library_shared {
    name: "libaudioroute-v34",
    shared_libs: ["libaudioroute"],
    vendor_available: true,
}

cc_library_shared {
    name: "libprotobuf-cpp-lite-3.9.1-vendorcompat",
    shared_libs: ["libprotobuf-cpp-lite"],
    vendor_available: true,
}

cc_library_shared {
    name: "libprotobuf-cpp-full-3.9.1-vendorcompat",
    shared_libs: ["libprotobuf-cpp-full"],
    vendor_available: true,
}